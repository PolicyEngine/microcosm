{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "battery.schema.json",
 "title": "Battery: completeness plus executable gates on the terminal simulated artifact",
 "x-spec-surface": "normative",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "contract_id",
  "version",
  "gates",
  "comparison_scope",
  "support_profile",
  "metric_kinds",
  "metric_registry",
  "joint_metric_registry",
  "thresholds",
  "metric_contracts",
  "authority_binding"
 ],
 "properties": {
  "contract_id": {"const": "us_stacked_origin_battery"},
  "version": {"type": "integer", "minimum": 1},
  "gates": {
   "type": "array",
   "minItems": 2,
   "maxItems": 2,
   "items": {"$ref": "defs.schema.json#/$defs/gate_record"}
  },
  "comparison_scope": {
   "type": "object",
   "additionalProperties": false,
   "required": ["left_support_channel", "right_support_channel", "clone_index", "weight_scope", "nulls", "invalid_values"],
   "properties": {
    "left_support_channel": {"$ref": "defs.schema.json#/$defs/identifier"},
    "right_support_channel": {"$ref": "defs.schema.json#/$defs/identifier"},
    "clone_index": {"const": "declared_per_registry_row"},
    "weight_scope": {"const": "resolved_entity_weight > 0"},
    "nulls": {"const": "fail_inside_scope"},
    "invalid_values": {"const": "fail_inside_scope"}
   }
  },
  "support_profile": {
   "type": "object",
   "additionalProperties": false,
   "required": ["profile_id", "version", "min_effective_support", "insufficient_support"],
   "properties": {
    "profile_id": {"$ref": "defs.schema.json#/$defs/identifier"},
    "version": {"type": "integer", "minimum": 1},
    "min_effective_support": {"type": "integer", "minimum": 0},
    "insufficient_support": {"const": "record_untestable_not_failure"}
   }
  },
  "metric_kinds": {
   "type": "array",
   "minItems": 4,
   "maxItems": 4,
   "uniqueItems": true,
   "items": {"enum": ["boolean_incidence", "rare_incidence", "monetary_sign_separated", "categorical_tvd"]}
  },
  "metric_registry": {
   "type": "array",
   "minItems": 1,
   "items": {"$ref": "#/$defs/metric_row"}
  },
  "joint_metric_registry": {
   "type": "array",
   "items": {"$ref": "#/$defs/joint_metric_row"}
  },
  "thresholds": {"$ref": "#/$defs/thresholds"},
  "metric_contracts": {"$ref": "#/$defs/metric_contracts"},
  "authority_binding": {
   "type": "object",
   "additionalProperties": false,
   "required": ["authority_id", "version"],
   "properties": {
    "authority_id": {"$ref": "defs.schema.json#/$defs/identifier"},
    "version": {"type": "integer", "minimum": 1}
   }
  }
 },
 "$defs": {
  "metric_row": {
   "type": "object",
   "additionalProperties": false,
   "required": ["entity", "family", "column", "clone_index", "metric"],
   "properties": {
    "entity": {"$ref": "defs.schema.json#/$defs/entity"},
    "family": {"$ref": "defs.schema.json#/$defs/identifier"},
    "column": {"$ref": "defs.schema.json#/$defs/identifier"},
    "clone_index": {"type": "integer", "minimum": 0},
    "metric": {"enum": ["boolean_incidence", "rare_incidence", "monetary_sign_separated", "categorical_tvd"]}
   }
  },
  "joint_metric_row": {
   "type": "object",
   "additionalProperties": false,
   "required": ["entity", "family", "columns", "clone_index", "metric"],
   "properties": {
    "entity": {"$ref": "defs.schema.json#/$defs/entity"},
    "family": {"$ref": "defs.schema.json#/$defs/identifier"},
    "columns": {"type": "array", "minItems": 2, "items": {"$ref": "defs.schema.json#/$defs/identifier"}},
    "clone_index": {"type": "integer", "minimum": 0},
    "metric": {"const": "categorical_tvd"}
   }
  },
  "thresholds": {
   "type": "object",
   "additionalProperties": false,
   "required": ["incidence_ratio", "conditional_quantile_envelope", "categorical_total_variation"],
   "properties": {
    "incidence_ratio": {
     "type": "object",
     "additionalProperties": false,
     "required": ["lower_inclusive", "upper_inclusive", "direction", "both_zero", "left_zero_right_positive"],
     "properties": {
      "lower_inclusive": {"type": "number", "minimum": 0},
      "upper_inclusive": {"type": "number", "minimum": 0},
      "direction": {"const": "acs_over_asec"},
      "both_zero": {"const": "fail_dead_comparison"},
      "left_zero_right_positive": {"const": "positive_infinity_and_fail"}
     }
    },
    "conditional_quantile_envelope": {
     "type": "object",
     "additionalProperties": false,
     "required": ["probabilities", "side", "distance", "maximum_inclusive", "applies_separately_to"],
     "properties": {
      "probabilities": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}},
      "side": {"const": "left"},
      "distance": {"type": "string", "minLength": 1},
      "maximum_inclusive": {"type": "number", "minimum": 0},
      "applies_separately_to": {"type": "array", "items": {"enum": ["positive_magnitude", "negative_magnitude"]}}
     }
    },
    "categorical_total_variation": {
     "type": "object",
     "additionalProperties": false,
     "required": ["distance", "maximum_inclusive"],
     "properties": {
      "distance": {"type": "string", "minLength": 1},
      "maximum_inclusive": {"type": "number", "minimum": 0}
     }
    }
   }
  },
  "metric_contracts": {
   "type": "object",
   "additionalProperties": false,
   "required": ["boolean_incidence", "rare_incidence", "monetary_sign_separated", "categorical_tvd"],
   "properties": {
    "boolean_incidence": {"$ref": "#/$defs/single_threshold_metric"},
    "rare_incidence": {"$ref": "#/$defs/single_threshold_metric"},
    "categorical_tvd": {"$ref": "#/$defs/single_threshold_metric"},
    "monetary_sign_separated": {
     "type": "object",
     "additionalProperties": false,
     "required": ["value_domain", "legs", "formula", "thresholds"],
     "properties": {
      "value_domain": {"const": "finite_numeric"},
      "legs": {"type": "array", "items": {"enum": ["positive", "negative"]}},
      "formula": {"type": "string", "minLength": 1},
      "thresholds": {"type": "array", "items": {"enum": ["incidence_ratio", "conditional_quantile_envelope"]}}
     }
    }
   }
  },
  "single_threshold_metric": {
   "type": "object",
   "additionalProperties": false,
   "required": ["value_domain", "formula", "threshold"],
   "properties": {
    "value_domain": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "integer"}}]},
    "formula": {"type": "string", "minLength": 1},
    "threshold": {"enum": ["incidence_ratio", "categorical_total_variation"]}
   }
  }
 }
}
