{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "defs.schema.json",
 "title": "Shared definitions for the microcosm spec bundle",
 "$defs": {
  "sha256": {
   "type": "string",
   "pattern": "^[a-f0-9]{64}$"
  },
  "identifier": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_]*$"
  },
  "kernel_ref": {
   "type": "string",
   "pattern": "^kernel:[a-z][a-z0-9_]*$"
  },
  "source_ref": {
   "type": "string",
   "pattern": "^source:[a-z][a-z0-9_.]*$"
  },
  "stream_ref": {
   "type": "string",
   "pattern": "^stream:[a-z][a-z0-9_.]*$"
  },
  "vintage_ref": {
   "type": "string",
   "pattern": "^vintage:[a-z][a-z0-9_]*$"
  },
  "entity": {
   "enum": [
    "person",
    "tax_unit",
    "spm_unit",
    "household",
    "family",
    "benunit",
    "marital_unit",
    "frame"
   ]
  },
  "surface": {
   "enum": [
    "normative",
    "run_request",
    "execution_profile",
    "operational",
    "chain_state"
   ],
   "description": "Only the normative projection is hashed into spec_sha256."
  },
  "row_scope": {
   "oneOf": [
    {
     "$ref": "defs.schema.json#/$defs/identifier"
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "all_of"
     ],
     "properties": {
      "all_of": {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/$defs/row_scope"
       }
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "any_of"
     ],
     "properties": {
      "any_of": {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/$defs/row_scope"
       }
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "not"
     ],
     "properties": {
      "not": {
       "$ref": "#/$defs/row_scope"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "channel_is"
     ],
     "properties": {
      "channel_is": {
       "$ref": "#/$defs/identifier"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "support_role_is"
     ],
     "properties": {
      "support_role_is": {
       "$ref": "#/$defs/identifier"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "column_predicate"
     ],
     "properties": {
      "column_predicate": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "entity",
        "column",
        "op"
       ],
       "properties": {
        "entity": {
         "$ref": "#/$defs/entity"
        },
        "column": {
         "$ref": "#/$defs/identifier"
        },
        "op": {
         "enum": [
          "eq",
          "ne",
          "is_null",
          "not_null"
         ]
        },
        "value": {}
       }
      }
     }
    }
   ],
   "description": "Closed predicate algebra: overlap, exhaustiveness, and equality are compiler-decidable."
  },
  "closed_scope_registry": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "predicate_space",
    "universe",
    "scopes"
   ],
   "properties": {
    "predicate_space": {
     "$ref": "#/$defs/identifier"
    },
    "universe": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "scopes": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "atoms"
      ],
      "properties": {
       "id": {
        "$ref": "#/$defs/identifier"
       },
       "atoms": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
         "type": "string",
         "minLength": 1
        }
       }
      }
     }
    }
   }
  },
  "gate_record": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "kernel",
    "metric",
    "input",
    "population",
    "slices",
    "reference",
    "min_support",
    "effective_sample_size",
    "thresholds",
    "uncertainty",
    "missing_slice",
    "status",
    "reason_map"
   ],
   "properties": {
    "id": {
     "$ref": "#/$defs/identifier"
    },
    "kernel": {
     "$ref": "#/$defs/kernel_ref"
    },
    "metric": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "formula_id"
     ],
     "properties": {
      "formula_id": {
       "$ref": "#/$defs/identifier"
      },
      "params": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "formula",
        "missing_or_null_in_scope",
        "declared_structural_absence"
       ],
       "properties": {
        "formula": {
         "$ref": "#/$defs/identifier"
        },
        "metric_contract_refs": {
         "type": "array",
         "uniqueItems": true,
         "items": {
          "$ref": "#/$defs/identifier"
         }
        },
        "missing_or_null_in_scope": {
         "$ref": "#/$defs/identifier"
        },
        "declared_structural_absence": {
         "$ref": "#/$defs/identifier"
        }
       }
      }
     }
    },
    "input": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "artifact",
      "stage"
     ],
     "properties": {
      "artifact": {
       "$ref": "#/$defs/identifier"
      },
      "stage": {
       "$ref": "#/$defs/identifier"
      }
     }
    },
    "population": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "universe",
      "denominator"
     ],
     "properties": {
      "universe": {
       "$ref": "#/$defs/row_scope"
      },
      "denominator": {
       "$ref": "#/$defs/identifier"
      }
     }
    },
    "slices": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "$ref": "#/$defs/identifier"
     }
    },
    "reference": {
     "oneOf": [
      {
       "type": "object",
       "additionalProperties": false,
       "required": ["kind", "release_id"],
       "properties": {
        "kind": {"const": "release"},
        "release_id": {"type": "string", "minLength": 1}
       }
      },
      {
       "type": "object",
       "additionalProperties": false,
       "required": ["kind", "sha256"],
       "properties": {
        "kind": {"const": "data_digest"},
        "sha256": {"$ref": "#/$defs/sha256"}
       }
      },
      {
       "type": "object",
       "additionalProperties": false,
       "required": ["kind", "fact_ref"],
       "properties": {
        "kind": {"const": "external_fact"},
        "fact_ref": {"$ref": "#/$defs/source_ref"}
       }
      },
      {
       "type": "object",
       "additionalProperties": false,
       "required": ["kind", "authority_ref"],
       "properties": {
        "kind": {"const": "compiled_authority"},
        "authority_ref": {"const": "authority_binding"}
       }
      }
     ]
    },
    "min_support": {
     "type": "integer",
     "minimum": 0
    },
    "effective_sample_size": {
     "oneOf": [
      {
       "type": "object",
       "additionalProperties": false,
       "required": ["method", "minimum", "not_applicable_reason"],
       "properties": {
        "method": {"const": "kish"},
        "minimum": {"type": "integer", "minimum": 0},
        "not_applicable_reason": {"type": "null"}
       }
      },
      {
       "type": "object",
       "additionalProperties": false,
       "required": ["method", "minimum", "not_applicable_reason"],
       "properties": {
        "method": {"const": "not_computed"},
        "minimum": {"type": "null"},
        "not_applicable_reason": {"$ref": "#/$defs/identifier"}
       }
      }
     ]
    },
    "thresholds": {
     "type": "object",
     "additionalProperties": false,
     "required": ["absolute", "relative"],
     "properties": {
      "absolute": {
       "type": "number"
      },
      "relative": {
       "type": "number"
      }
     }
    },
    "uncertainty": {
     "oneOf": [
      {
       "type": "object",
       "additionalProperties": false,
       "required": ["rule"],
       "properties": {"rule": {"const": "none"}}
      },
      {
       "type": "object",
       "additionalProperties": false,
       "required": ["rule", "seeds"],
       "properties": {
        "rule": {"const": "multi_seed"},
        "seeds": {"type": "integer", "minimum": 2}
       }
      },
      {
       "type": "object",
       "additionalProperties": false,
       "required": ["rule", "confidence_level", "method"],
       "properties": {
        "rule": {"const": "interval"},
        "confidence_level": {
         "type": "number",
         "exclusiveMinimum": 0,
         "exclusiveMaximum": 1
        },
        "method": {"$ref": "#/$defs/identifier"}
       }
      }
     ]
    },
    "missing_slice": {
     "enum": [
      "fail",
      "skip_with_receipt"
     ]
    },
    "status": {
     "enum": [
      "fail",
      "warn",
      "report_only"
     ]
    },
    "reason_map": {
     "type": "object",
     "minProperties": 1,
     "propertyNames": {"$ref": "#/$defs/identifier"},
     "additionalProperties": {
      "$ref": "#/$defs/identifier"
     }
    }
   }
  }
 }
}
