{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "resource_manifest.schema.json",
 "title": "Typed resource rows for country_package.json (the SINGLE manifest)",
 "x-spec-surface": "normative",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "country",
  "resources"
 ],
 "properties": {
  "schema_version": {
   "type": "integer",
   "minimum": 1
  },
  "country": {
   "$ref": "defs.schema.json#/$defs/identifier"
  },
  "resources": {
   "type": "array",
   "x-canonical-order": "set",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "path",
     "kind",
     "schema_id"
    ],
    "properties": {
     "path": {
      "type": "string",
      "pattern": "^[a-z0-9_./-]+$"
     },
     "kind": {
      "enum": [
       "bundle",
       "sources",
       "spine",
       "geography",
       "imputation",
       "take_up",
       "battery",
       "calibration",
       "selection",
       "publication",
       "vintages",
       "catalogs",
       "schema",
       "legacy_json"
      ]
     },
     "schema_id": {
      "type": "string"
     }
    }
   }
  }
 }
}
