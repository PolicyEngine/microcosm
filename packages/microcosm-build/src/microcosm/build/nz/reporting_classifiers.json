    }
  },
  "rank_method_note": "Provisional within-unit weighted rank convention: sort by income then stable unit id, assign floor(n_bins * (preceding_weight + unit_weight / 2) / total_weight) + 1, clamped to 1..n_bins. Tied units and clones remain distinct reporting units and may land in different cells; no row is split. This midpoint convention adds a precise boundary convention to A1 and awaits confirmation of the publication method.",
  "tie_key_evidence": {
    "stability": "Same pinned donor and unit rule preserve person ids across rebuilds; each family id is its head person id. Units sharing source household lineage remain distinct units.",
    "implementation": [
      "packages/microcosm-frame/src/microcosm/frame/unit_construction.py build_benefit_units (each family id is its head person's id)",
      "microcosm.build.transport.population_kernels.TransportCreateKernel",
      "microcosm.frame.transport.read_populace_us_donor"
    ],
    "citation": {
      "item": "A1",
      "source": "docs/nz-reporting-classifiers-method.md#a1-income-decile-provisional"
    }
  },
  "blocked_inputs": [],
  "unsupported_receipt_inputs": [
    {
      "column": "receives_veterans_pension",
      "evidence": "axiom_input_closure.json receipt_flags omits this flag; main_benefit_receiving_veterans_pension defaults false because Veterans Pension is not modelled in v0",
      "required_behavior": "The hub reports Veterans Pension as unsupported under H4 and excludes its component and predicate column. The kernel must refuse any declaration that requests an unavailable flag; a missing flag never implies false.",
      "citation": {
        "item": "A2",
        "source": "docs/nz-reporting-classifiers-method.md#a2-receipt-group"
      }
    }
  ],
  "disclosures": [
    {
      "note": "NZ Super is overstated for single people who share a home because the shares-residence input defaults false; this moves their deciles upward.",
      "evidence": "axiom_input_closure.json#/entries[input=nz_super_shares_residence_with_person_at_least_adult_age]",
      "citation": {
        "item": "A1",
        "source": "docs/nz-reporting-classifiers-method.md#a1-income-decile-provisional"
      }
    },
    {
      "note": "Market-income components follow the existing family gross-income concept mapping. Rental income is after business expenses. The rental and private-pension concept descriptions do not explicitly say before tax; their before-tax transport interpretation must be verified before activation.",
      "evidence": "packages/microcosm-frame/src/microcosm/frame/adapters/axiom_concept_mappings/nz.json#/bindings[canonical_input=nz:statutes~1social_security~1accommodation_supplement~1core#input.accommodation_supplement_relevant_weekly_income]; packages/microcosm-frame/src/microcosm/frame/concepts.py _amount(\"rental_income\") and _amount(\"private_pension_income\")",
      "citation": {
        "item": "A1",
        "source": "docs/nz-reporting-classifiers-method.md#a1-income-decile-provisional"
      }
    },
    {
      "note": "The hub leaves Veterans Pension unsupported under H4: the June 2026 feed reports 4,674 recipients, and v0 supplies no veteran facts or receipt producer. Reporting omits its benefit income and predicate rather than inventing a false receipt flag.",
      "evidence": "reference_inventory.json; receipt_contract.json#/receipts/unmodelled_programs"
    }
  ],
