{
  "version": 1,
  "country": "nz",
  "method_card_row": "MC9",
  "description": "Territorial authority to Accommodation Supplement area crosswalk. Each row gives one territorial authority's population shares across Areas 1-4; the atomic geography support multiplies Chronicle territorial-authority population by these shares, households draw one territorial authority by area unit, and the area columns derive from it. Area membership is defined by Work and Income on 2017 Statistical Area Unit names, not territorial authorities, so a share is the population of the authority's area units in each area divided by the authority's population. Where an authority spans areas the population-weighted split is a declared assumption (MC9).",
  "status": "requires_harvest",
  "status_reason": "No rows yet. Computing shares needs two sources this package does not hold: (1) a 2017 Statistical Area Unit to territorial authority concordance (the Stats NZ Geographic Areas File 2017 sits behind a DataFinder login; the public Stats NZ ArcGIS Area_Unit_2017 layer carries area-unit codes and names but no territorial-authority attribute, checked 2026-10-07); (2) area-unit usually resident population. Until rows exist the geography support kernel must refuse this resource.",
  "method": {
    "central": {
      "id": "as_area",
      "rule": "population_weighted_split",
      "weights": "usually resident population of each territorial authority's 2017 area units in each Accommodation Supplement area"
    },
    "alternative": {
      "id": "as_area_alt",
      "scenario": "S3",
      "rule": "modal_area",
      "description": "assign the whole territorial authority to the area holding its largest population share; a tie is refused for review, never broken silently"
    },
    "share_tolerance": 1e-09
  },
  "ta_vintage": "ta_2025",
  "effective_period": {
    "definitions_from": "2018-04-01",
    "model_period": {
      "start": "2026-04-01",
      "end": "2027-03-31"
    },
    "note": "The 1 April 2018 definitions cover the whole model year. The Budget 2025 area redraw takes effect in April 2027, after it (targets doc H4c, a search-snippet citation)."
  },
