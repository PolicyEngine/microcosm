# shellcheck shell=bash
# Copy to route_a.env, or point ROUTE_A_ENV at a machine-local settings file.
# No credentials belong here. Environment overrides win over these defaults.
# All machine locations are configured here; the driver uses colocated helpers.
: "${PE:=$HOME/PolicyEngine}"
: "${MAIN:=$PE/microcosm}"
: "${WT_ROOT:=$PE/_worktrees}"
# Use a fresh root for a new attempt. Do not reuse a pre-CT base's ACCEPTED marker.
: "${RUN_ROOT:=$PE/_route-a-runs}"
: "${CHAIN_ROOT:=$PE/_recovered/scratch-backup/893/overnight-20260923}"
: "${CHAIN_LOG:=$CHAIN_ROOT/chain.log}"
: "${DISK_PATH:=/System/Volumes/Data}"
: "${UV:=$HOME/.local/bin/uv}"
: "${PYTHON:=python3}"
: "${AGENT_SECRET:=$HOME/bin/agent-secret}"
# STORAGE holds census_cps_2023/2024/2025.h5 (the default ASEC pool, d2603) with
# the PUF and ACS files; EDU holds asecpub24/25/26csv.zip.
: "${STORAGE:=$PE/policyengine-us-data/policyengine_us_data/storage}"
: "${EDU:=$PE/_buildm-runtime/inputs/asec_education}"
: "${FEED:=$PE/_buildh-runtime/inputs/consumer_facts_us_c5e5bf8.jsonl}"
# The driver preserves the published feed/crosswalk pins by default. If the
# chosen commit changed them, set FEED_SHA, FEED_BYTES and CROSSWALK_SHA here
# alongside FEED, after checking that commit's packaged pins; --resolve names
# the commit's own feed digest and crosswalk digest in its blockers.
# d713: CT-fixed ladder; route_a.sh verifies its digest and size, which
# LADDER_SHA and LADDER_BYTES default to. Set all three for another ladder,
# such as one rebuilt on main for block_v1 (it must carry each block's PUMA).
: "${LADDER:=$PE/_build_artifacts/us-ct-cbsa/us_block_ladder_2020.npz}"
: "${SSI:=$PE/_buildo-runtime/inputs/attempt6_basis_schema3_seed.json}"
# SCF: rscfp2022.dta from the Fed's 2026-10-09 republication of scfp2022s.zip
# (microcosm#1368); fetch_scf_2022_summary_extract() caches it in
# ~/.cache/microcosm/scf. The older 2022-dollar file fails the driver's pin.
: "${SCF:=$HOME/.cache/microcosm/scf/rscfp2022.dta}"

# Choose a pushed build commit. Empty COMMIT refuses a real run.
: "${COMMIT:=}"
: "${REQUIRE_ON_MAIN:=1}"
: "${REQUIRE_SPM_ROLE:=1}"
: "${PREFLIGHT_COMMIT:=}"
: "${PREFLIGHT_NEW_LINEAGE_ARGS:=--new-lineage}"
: "${EARLY_START_AFTER_HEAVY:=0}"
: "${PRUNE_BASE_CHECKPOINTS:=1}"
: "${RELEASE_DESPITE_PREFLIGHT_FAIL:=0}"
: "${RESOURCE_WAIT_HOURS:=12}"
# 1 stops before the release so its gates can be dry-run on the fresh base
# (tools/dry_run_us_release_gates.py --release-config <run>/release-config.json);
# rerun with 0 to continue.
: "${STOP_BEFORE_RELEASE:=0}"
# uv sync in a fresh worktree; the lock's torch wheels stop at CPython 3.14.
: "${UV_SYNC_PYTHON:=3.14}"
# The base's household location rule: legacy (the published run's SOI district
# draw) or block_v1 (microcosm#1047: one 2020 block per household within its
# CPS source geography). block_v1 needs a block ladder with each block's PUMA.
# block_v1 is for a base this driver builds: a Modal base is always legacy.
: "${LOCATION_RULE:=legacy}"
# The release starts microcosm-emitter (MICROCOSM_EMITTER_COMMAND, then PATH)
# and refuses one older than the commit's minimum_emitter_version.json.
# PolicyEngine builds set MICROCOSM_TELEMETRY_REQUIRED=1, and --resolve then
# blocks on a missing or old emitter. Unset or 0 still starts an emitter that
# meets the floor, but lets the release go on without telemetry when none
# does. The driver exports either setting made here.
# : "${MICROCOSM_TELEMETRY_REQUIRED:=1}"
: "${RELEASE_RAM_GIB:=50}"
: "${RELEASE_WALL_SECONDS:=345600}"
# 0 is the sole opt-out and restores --no-staging without a credential lookup.
: "${ROUTE_A_STAGING=1}"
# 0 stops after the build, at ROUTE_A_BUILT.json. 1, like route_a.sh --certify,
# also certifies the build and runs the release-gate and publisher preflights.
: "${ROUTE_A_CERTIFY=0}"

# Retain d122 whole-base dense national/state settings and the published run's
# export-mass reference.
: "${DENSE_RELEASE_D122:=1}"
: "${EXPORT_MASS_REF_H5:=$PE/_buildg-runtime/forensics/populace_us_2024.h5}"
: "${RELEASE_EXTRA_ARGS:=--maximum-microsim-batch-size 2000 --target-surface national_state --dense-default-dataset --export-input-mass-reference-h5 $EXPORT_MASS_REF_H5}"
# No QRF tail register by default. Since 17 Nov 2026 the release decides the
# tail gate at base (pre-calibration) weights, so the published run's d490
# register (measured at final weights) would read as stale. Set both only for a
# register measured at base weights on the base that ships.
# : "${QRF_TAIL_EXCLUSIONS:=$CHAIN_ROOT/route-a/qrf_tail_exclusions_routea_d490_20260930.json}"
# : "${QRF_TAIL_EXCLUSIONS_SHA:=fa5760993ebcd1386f02c0b1c4c4e867a0c4b1e689a33774a41f623f95132d69}"
# Optional base feed override: BASE_LEDGER_FACTS and BASE_LEDGER_FACTS_SHA.
