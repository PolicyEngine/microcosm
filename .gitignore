__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
dist/
build/
out/
*.h5
# Licensed run outputs: pool tables and audit directories (UKDS CD137 cl. 8).
*.npz
# Except the H2 parity fixture's three toy conditioned atomic-area supports,
# which tools/graph_uk_spine_fixture.py writes from test support's invented
# table over public area codes, as toy_<source id>.npz: a real support keeps
# its own name and stays ignored (microcosm#931).
!packages/microcosm-graph/tests/fixtures/parity/uk_spine/sources/toy_uk_ew_output_area_2021_conditioned_support.npz
!packages/microcosm-graph/tests/fixtures/parity/uk_spine/sources/toy_uk_scotland_output_area_2022_conditioned_support.npz
!packages/microcosm-graph/tests/fixtures/parity/uk_spine/sources/toy_uk_ni_data_zone_2021_conditioned_support.npz
audit-*/
!packages/*/build/
# microcosm.build is a real namespace package, not a build-artifact dir
!packages/microcosm-build/src/microcosm/build/

# Release alert webhooks (real file is machine-local; .example is tracked)
tools/release.env
tools/route_a/route_a.env
/inputs/

# Finder metadata — never payload
.DS_Store

# Dense sign-off drafts (tools/draft_uk_dense_signoff.py): the private review
# file holds licensed-data review values and is never committed
PRIVATE_review.csv
signoff-draft/

# Spine stage profiles (--stage-profile-dir, microcosm#931): a record keeps the
# message of a failure its node raised, so profiles stay private
stage_profile.json
.stage_profile.json.lock
